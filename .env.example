# Copy this template to the ignored application-root .env (project/.env from the repository root) and enter credentials there.
# Runtime npm commands load project/.env when run from the application root; existing shell exports take precedence.
# Never paste keys into chat or expose them through NEXT_PUBLIC_ variables.
MODEL_API_KEY=
# Studio and CLI calls share a durable estimated/actual usage history; no local spend cap.
DATABASE_PATH=data/klinikaflow.sqlite
# Live sheet mode stays off until clinician/native-speaker review passes.
SHEET_MODE=template
ALLOW_LIVE_MODE=false
# Individual accounts replace the shared studio token. Run npm run admin:create.
# Forwarded client IPs are trusted only behind an operator-configured reverse proxy.
TRUST_PROXY=false
# Optional exact externally visible origin when testing behind a proxy.
APP_ORIGIN=

# New paid capabilities remain off until explicit synthetic acceptance.
ENABLE_NOTE_CORRECTIONS=false
ENABLE_PLAN_QUESTIONS=false
# Requires ENABLE_PLAN_QUESTIONS too.
ENABLE_SPOKEN_QUESTIONS=false
# Selects the custom Node/WebSocket launcher for dev/start; off by default.
ENABLE_REALTIME_TRANSCRIPTION=false

# PNG/JPEG/PDF upload and explicit Spark extraction; keep off until synthetic acceptance.
ENABLE_DOCUMENT_IMPORT=false

# Efficient Responses/compact requests stay opt-in until the selected workload passes live comparison.
META_REQUEST_PROFILE=legacy
# Only used by efficient; 24h is an explicit provider hint, not a guaranteed hit.
META_PROMPT_CACHE_RETENTION=in_memory
